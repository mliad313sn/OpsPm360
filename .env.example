# PostgreSQL connection string
DATABASE_URL="postgresql://opspm:opspm@localhost:5432/opspm360?schema=public"

# 32+ char secret used to sign session JWTs (generate: openssl rand -base64 48)
SESSION_SECRET="change-me-to-a-long-random-string-in-production"

# Shared secret required by the /api/escalations SLA sweep endpoint (cron caller)
CRON_SECRET="change-me-cron-secret"

# Base URL of the deployment (used in notifications and OIDC redirect URI)
APP_URL="http://localhost:3000"

# ── Optional: corporate SSO (OIDC — Entra ID / Okta / Keycloak) ──────────────
# When all three are set, "Sign in with corporate SSO" appears on the login page.
# Redirect URI to register with the IdP: $APP_URL/api/auth/oidc/callback
# OIDC_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""

# ── Optional: notifications & audit lifecycle ────────────────────────────────
# Slack/Teams/ITSM intake webhook for escalations and steering decisions
# NOTIFY_WEBHOOK_URL=""
# Audit rows older than this many days are offloaded by /api/audit-retention
AUDIT_RETENTION_DAYS="90"
# NDJSON archive sink (S3 presigned endpoint, SIEM intake). Purge only happens
# after a successful archive unless AUDIT_PURGE_WITHOUT_ARCHIVE=true.
# ARCHIVE_WEBHOOK_URL=""
